# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gpt_image_saas?schema=public

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-with-openssl-rand-base64-32
ADMIN_EMAILS=admin@example.com

# OpenAI image generation. Keep this server-side only.
OPENAI_API_KEY=
OPENAI_IMAGE_DEFAULT_MODEL=gpt-image-2
OPENAI_IMAGE_FALLBACK_MODEL=gpt-image-1-mini

# Login providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
EMAIL_SERVER=
EMAIL_FROM=

# Stripe Checkout
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLIC_KEY=

# Redis rate limit
REDIS_URL=redis://localhost:6379

# App
APP_NAME=AI Image Creative Station
APP_URL=http://localhost:3000
SIGNUP_BONUS_CREDITS=10

# Local uploads
LOCAL_UPLOAD_DIR=./uploads
PUBLIC_UPLOAD_BASE_URL=/uploads

# S3-compatible storage. Leave empty to use local storage.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# Rate limits
RATE_LIMIT_GENERATION_PER_MINUTE=5
RATE_LIMIT_IP_PER_MINUTE=10

# Disabled by default because legacy endpoints accept client-supplied keys and bypass SaaS credits.
ALLOW_LEGACY_CLIENT_API=false

# Existing 302 AI project settings, retained for original localized pages.
NEXT_PUBLIC_302_API_KEY=
NEXT_PUBLIC_API_URL=https://api.302.ai
NEXT_PUBLIC_DEFAULT_MODEL_NAME=gpt-image-2
NEXT_PUBLIC_HIDE_BRAND=true
NEXT_PUBLIC_LOG_LEVEL=debug
NEXT_PUBLIC_AUTH_API_URL=https://dash-api.302.ai
NEXT_PUBLIC_302_WEBSITE_URL_CHINA=https://302ai.cn/
NEXT_PUBLIC_302_WEBSITE_URL_GLOBAL=https://302.ai/
NEXT_PUBLIC_AUTH_PATH=/auth
NEXT_PUBLIC_DEV_HOST_NAME=
NEXT_PUBLIC_IS_CHINA=false
NEXT_PUBLIC_DEFAULT_LOCALE=en
