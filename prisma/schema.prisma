generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER  @map("user")
  ADMIN @map("admin")
}

enum UserStatus {
  ACTIVE @map("active")
  BANNED @map("banned")
}

enum GenerationMode {
  TEXT_TO_IMAGE @map("text_to_image")
  IMAGE_EDIT    @map("image_edit")
  VARIATION     @map("variation")
  STYLE         @map("style")
}

enum GenerationStatus {
  PENDING @map("pending")
  SUCCESS @map("success")
  FAILED  @map("failed")
}

enum CreditTransactionType {
  PURCHASE         @map("purchase")
  GENERATION       @map("generation")
  REFUND           @map("refund")
  ADMIN_ADJUSTMENT @map("admin_adjustment")
  SIGNUP_BONUS     @map("signup_bonus")
}

enum OrderProvider {
  STRIPE @map("stripe")
  MANUAL @map("manual")
}

enum OrderStatus {
  PENDING  @map("pending")
  PAID     @map("paid")
  FAILED   @map("failed")
  REFUNDED @map("refunded")
}

model User {
  id                 String              @id @default(cuid())
  email              String?             @unique
  emailVerified      DateTime?           @map("email_verified")
  name               String?
  image              String?             @map("avatar")
  role               UserRole            @default(USER)
  credits            Int                 @default(0)
  status             UserStatus          @default(ACTIVE)
  accounts           Account[]
  sessions           Session[]
  generationLogs     GenerationLog[]
  creditTransactions CreditTransaction[]
  orders             Order[]
  adminAuditLogs     AdminAuditLog[]     @relation("AdminAudit")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model GenerationLog {
  id             String           @id @default(cuid())
  userId         String           @map("user_id")
  requestId      String?          @unique @map("request_id")
  prompt         String           @db.Text
  negativePrompt String?          @map("negative_prompt") @db.Text
  mode           GenerationMode
  model          String
  size           String?
  quality        String?
  inputImageUrl  String?          @map("input_image_url") @db.Text
  outputImageUrl String?          @map("output_image_url") @db.Text
  costCredits    Int              @default(0) @map("cost_credits")
  status         GenerationStatus @default(PENDING)
  errorMessage   String?          @map("error_message") @db.Text
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime         @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([model])
  @@index([status])
  @@map("generation_logs")
}

model CreditTransaction {
  id             String                @id @default(cuid())
  userId         String                @map("user_id")
  type           CreditTransactionType
  amount         Int
  balanceAfter   Int                   @map("balance_after")
  description    String?               @db.Text
  relatedOrderId String?               @map("related_order_id")
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  relatedOrder   Order?                @relation(fields: [relatedOrderId], references: [id])
  createdAt      DateTime              @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([relatedOrderId])
  @@map("credit_transactions")
}

model Order {
  id              String              @id @default(cuid())
  userId          String              @map("user_id")
  provider        OrderProvider
  providerOrderId String?             @unique @map("provider_order_id")
  amount          Decimal             @db.Decimal(10, 2)
  currency        String              @default("USD")
  credits         Int
  status          OrderStatus         @default(PENDING)
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions    CreditTransaction[]
  createdAt       DateTime            @default(now()) @map("created_at")
  paidAt          DateTime?           @map("paid_at")

  @@index([userId, createdAt])
  @@index([status])
  @@map("orders")
}

model Plan {
  id        String   @id @default(cuid())
  name      String
  price     Decimal  @db.Decimal(10, 2)
  currency  String   @default("USD")
  credits   Int
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive, sortOrder])
  @@map("plans")
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String   @db.Text
  description String?  @db.Text
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model AdminAuditLog {
  id          String   @id @default(cuid())
  adminUserId String   @map("admin_user_id")
  action      String
  targetType  String   @map("target_type")
  targetId    String?  @map("target_id")
  detail      Json?
  adminUser   User     @relation("AdminAudit", fields: [adminUserId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([adminUserId, createdAt])
  @@index([targetType, targetId])
  @@map("admin_audit_logs")
}
